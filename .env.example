# Copy to .env and replace every CHANGE_ME value. No real provider key belongs here.
NODE_ENV=development
LOG_LEVEL=info
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=neurallayer
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/neurallayer
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
ADMIN_PORT=3000
ADMIN_WORKSPACE_ID=
ADMIN_SMOKE_WORKSPACE_ID=
ADMIN_ACCESS_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
PROVIDER_CREDENTIALS_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_SECRET
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:4000
# Optional: only for live benchmark sync. Leave blank for offline tests.
ARTIFICIAL_ANALYSIS_API_KEY=
